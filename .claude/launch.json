{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-c",
        "import os,http.server,socketserver; socketserver.TCPServer.allow_reuse_address=True; socketserver.TCPServer(('',int(os.environ.get('PORT','4173'))),http.server.SimpleHTTPRequestHandler).serve_forever()"
      ],
      "port": 4173,
      "autoPort": true
    }
  ]
}
